{
  "name": "asr-studio-desktop",
  "version": "0.1.0",
  "description": "Local ASR desktop application.",
  "license": "GPL-3.0-only",
  "author": "Alfred Clark",
  "homepage": "https://github.com/AlfredClark/asr-studio-desktop",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlfredClark/asr-studio-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/AlfredClark/asr-studio-desktop/issues"
  },
  "keywords": [
    "tauri",
    "desktop",
    "asr",
    "studio"
  ],
  "type": "module",
  "imports": {
    "#assets/*": "./src/assets/*",
    "#components/*": "./src/components/*",
    "#libs/*": "./src/libs/*"
  },
  "packageManager": "pnpm@12.13.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:local": "tauri build --no-bundle",
    "tauri:icon": "tauri icon src-tauri/app-icon.svg && rimraf src-tauri/icons/ios src-tauri/icons/android",
    "i18n:compile": "paraglide-js compile --project ./src/libs/i18n/project.inlang",
    "i18n:translate": "inlang machine translate --project src/libs/i18n/project.inlang",
    "clean": "rimraf build/ node_modules/.vite .svelte-kit target/",
    "clean:frontend": "rimraf build/ node_modules/.vite .svelte-kit",
    "clean:backend": "rimraf target/",
    "lint": "pnpm lint:frontend && pnpm lint:backend",
    "lint:frontend": "prettier --check . && eslint .",
    "lint:backend": "cargo fmt --manifest-path Cargo.toml --all -- --check && cargo clippy --manifest-path Cargo.toml --workspace --all-targets -- -D warnings && cargo check --manifest-path Cargo.toml --workspace",
    "format": "pnpm format:frontend && pnpm format:backend",
    "format:frontend": "prettier --write . && eslint --fix .",
    "format:backend": "cargo fmt --manifest-path Cargo.toml --all",
    "validate": "pnpm test && pnpm lint && pnpm check",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node scripts/check-version-sync.ts && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:sync": "node scripts/check-version-sync.ts",
    "test": "pnpm test:vitest && pnpm test:cargo",
    "test:watch": "vitest",
    "test:vitest": "vitest run --fsModuleCache",
    "test:cargo": "cargo test --manifest-path Cargo.toml --workspace",
    "audit": "pnpm audit --audit-level=high --registry=${NPM_AUDIT_REGISTRY:-https://registry.npmjs.org/}",
    "audit:backend": "cargo deny check advisories bans sources",
    "update:all": "pnpm update:frontend && pnpm update:backend && pnpm check:sync",
    "update:frontend": "pnpm update",
    "update:backend": "cargo update --manifest-path Cargo.toml --workspace",
    "changelog": "git-cliff --output CHANGELOG.md",
    "changelog:preview": "git-cliff --unreleased",
    "version:patch": "node scripts/bump-version.ts patch",
    "version:minor": "node scripts/bump-version.ts minor",
    "version:major": "node scripts/bump-version.ts major",
    "version:set": "node scripts/bump-version.ts",
    "release": "bumpp package.json src-tauri/tauri.conf.json src-tauri/Cargo.toml --all --commit \"chore(release): prepare for {tag}\" --push false",
    "prepare": "husky"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-deep-link": "^2.6.2",
    "@tauri-apps/plugin-log": "^2.10.1",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "mode-watcher": "^1.1.0",
    "tauri-plugin-system-fonts-api": "^2.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@inlang/cli": "^3.4.4",
    "@inlang/paraglide-js": "^2.28.0",
    "@inlang/paraglide-js-svelte": "^1.0.4",
    "@inlang/plugin-m-function-matcher": "^2.3.4",
    "@inlang/plugin-message-format": "^4.5.4",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.57.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "bits-ui": "^2.19.5",
    "bumpp": "^12.3.0",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "git-cliff": "^2.14.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-css-order": "^2.2.0",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.9.0",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
