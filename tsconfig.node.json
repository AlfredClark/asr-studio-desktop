{
  // 编译器配置
  "compilerOptions": {
    // 启用项目引用约束与增量构建产物记录
    "composite": true,
    // 跳过对第三方依赖声明文件的类型检查
    "skipLibCheck": true,
    // 指定生成的代码采用最新的 ECMAScript 模块标准
    "module": "ESNext",
    // 指定模块解析策略为 bundler
    "moduleResolution": "bundler",
    // 开启全套严格类型检查
    "strict": true,
    // 显式注入全局类型声明库，与浏览器端项目隔离
    "types": ["node"]
  },
  // 划定该配置文件负责管理的目标文件范围
  "include": [
    "commitlint.config.ts",
    "eslint.config.ts",
    "lint-staged.config.ts",
    "svelte.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "scripts/**/*.ts",
    "scripts/**/*.mjs",
    "src/scripts/**/*.ts",
    "src/scripts/**/*.mjs"
  ]
}
