  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "实心主操作：确认、检查更新、提交设置。",
      "html": "<button class=\"ds-btn-primary\">Check for updates</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 10px;border:1px solid transparent;border-radius:var(--radius);background:var(--primary);color:var(--primary-foreground);font-family:inherit;font-size:.875rem;font-weight:500;white-space:nowrap;cursor:pointer;transition:background-color .15s,box-shadow .15s,transform .15s}.ds-btn-primary:hover{background:color-mix(in oklab,var(--primary) 80%,transparent)}.ds-btn-primary:focus-visible{outline:none;border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in oklab,var(--ring) 50%,transparent)}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:disabled{pointer-events:none;opacity:.5}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "次级操作：取消、字体选择器触发器等。",
      "html": "<button class=\"ds-btn-outline\">Cancel</button>",
      "css": ".ds-btn-outline{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 10px;border:1px solid var(--border);border-radius:var(--radius);background:var(--background);color:var(--foreground);font-family:inherit;font-size:.875rem;font-weight:500;white-space:nowrap;cursor:pointer;transition:background-color .15s,color .15s,box-shadow .15s,transform .15s}.ds-btn-outline:hover{background:var(--muted);color:var(--foreground)}.ds-btn-outline:focus-visible{outline:none;border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in oklab,var(--ring) 50%,transparent)}.ds-btn-outline:active{transform:translateY(1px)}.ds-btn-outline:disabled{pointer-events:none;opacity:.5}"
    },
    {
      "name": "Ghost Icon Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "标题栏窗口控制（置顶 / 最小化 / 最大化 / 关闭）与工具位图标按钮，28px。",
      "html": "<button class=\"ds-btn-ghost\" type=\"button\" aria-label=\"Keep on top\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 17v5\"/><path d=\"M9 10.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z\"/></svg></button><button class=\"ds-btn-ghost ds-btn-ghost-close\" type=\"button\" aria-label=\"Close\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M18 6 6 18\"/><path d=\"m6 6 12 12\"/></svg></button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;padding:0;border:none;border-radius:min(calc(var(--radius) * .8),12px);background:transparent;color:var(--foreground);cursor:pointer;transition:background-color .15s,color .15s}.ds-btn-ghost svg{width:16px;height:16px}.ds-btn-ghost:hover{background:var(--muted);color:var(--foreground)}.ds-btn-ghost:focus-visible{outline:none;box-shadow:0 0 0 3px color-mix(in oklab,var(--ring) 50%,transparent)}.ds-btn-ghost-close:hover{background:color-mix(in oklab,var(--destructive) 10%,transparent);color:var(--destructive)}"
    },
