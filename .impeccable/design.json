      "html": "<button class=\"ds-btn-destructive\">Reset to defaults</button>",
      "css": ".ds-btn-destructive{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 10px;border:1px solid transparent;border-radius:var(--radius);background:color-mix(in oklab,var(--destructive) 10%,transparent);color:var(--destructive);font-family:inherit;font-size:.875rem;font-weight:500;white-space:nowrap;cursor:pointer;transition:background-color .15s,box-shadow .15s,transform .15s}.ds-btn-destructive:hover{background:color-mix(in oklab,var(--destructive) 20%,transparent)}.ds-btn-destructive:focus-visible{outline:none;box-shadow:0 0 0 3px color-mix(in oklab,var(--destructive) 20%,transparent)}.ds-btn-destructive:active{transform:translateY(1px)}.ds-btn-destructive:disabled{pointer-events:none;opacity:.5}"
