{
  // 继承 SvelteKit 自动生成的配置；tsconfig.aliases.json 提供 # 别名的 TS 侧镜像
  // （运行时/构建的权威定义在 package.json 的 imports 字段，两者由 check:sync 校验一致）
  "extends": ["./.svelte-kit/tsconfig.json", "./tsconfig.aliases.json"],
  // 编译器配置
  "compilerOptions": {
    // 允许在项目中引入并编译原生 JavaScript 文件
    "allowJs": true,
    // 对项目中的原生 .js 文件同样执行 TypeScript 类型推导和错误检查
    "checkJs": true,
    // 启用 CommonJS 与 ES 模块之间的互操作兼容层
    "esModuleInterop": true,
    // 强制路径中文件名的大小写必须严格一致
    "forceConsistentCasingInFileNames": true,
    // 允许直接用 import 导入 JSON 文件
    "resolveJsonModule": true,
    // 跳过对第三方依赖声明文件的内部类型检查
    "skipLibCheck": true,
    // 生成与编译代码相对应的 source map
    "sourceMap": true,
    // 开启 TypeScript 全套严格类型检查模式
    "strict": true,
    // 指定模块解析策略为现代打包器模式
    "moduleResolution": "bundler"
  },
  // 参考声明：Node 侧工具链配置文件
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
